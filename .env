# ==============================
# SmartDine Backend - Sample ENV
# Copy this file to ".env" and fill in real values
# ==============================

# Server
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:8080

# MongoDB
MONGO_URI=mongodb+srv://staging:teja1234@cluster0.sp96txq.mongodb.net/smartdine

# For MongoDB Atlas, use something like:
# MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smartdine?retryWrites=true&w=majority

# JWT Auth
JWT_SECRET=replace_with_a_long_random_secret_key
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_DAYS=7

# Admin bootstrap account (created automatically on first run if not present)
ADMIN_EMAIL=admin@smartdine.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=Super Admin

# Payments (Razorpay) - optional, used if PAYMENT_PROVIDER=razorpay
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Cloudinary (menu images) - optional
CLOUDINARY_CLOUD_NAME=dbkanbsre
CLOUDINARY_API_KEY=194161536218922
CLOUDINARY_API_SECRET=mdeilVkxbtXqdoGn-QWUghQKOxY

# Rate limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# QR Code
QR_BASE_URL=http://localhost:3000/table


# ── NodeMailer (Transactional Email) ────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
